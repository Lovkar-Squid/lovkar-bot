# --- required ---------------------------------------------------------------
# Discord Developer Portal > your application > Bot > Reset Token.
# Paste it here on the server only. It never goes into git and never leaves the box.
DISCORD_TOKEN=

# The server the bot works in (right-click the server icon > Copy Server ID).
GUILD_ID=1546115271410843739

# --- what it does -----------------------------------------------------------
# The role everyone in the server gets. Must sit BELOW the bot's own role.
MEMBER_ROLE_NAME=Dreamer

# The forum channel it triages. Severity tags are created there if missing.
BUG_FORUM_NAME=bug-reports
NEEDS_LOG_TAG_NAME=needs log

# Set to 1 for one run to give the role to everyone already in the server,
# then set it back to 0. Harmless to leave on, just slower to start.
BACKFILL_MEMBER_ROLE=0

# The short note the bot posts under a triaged report. 0 = tag silently.
TRIAGE_REPLY=1

# 1 = decide and log everything, write nothing. Good for the first run.
DRY_RUN=0

# --- the optional second opinion --------------------------------------------
# Leave empty for keywords only (free, instant). "gemini" or "anthropic" adds a
# model pass for reports the keywords do not cover - other languages, roundabout
# descriptions. It can only move a report between the same three buckets, and
# never below the evidence.
LLM_PROVIDER=

# One key, or several (comma / space / newline separated) - one per Google
# project. A key that answers 429 or "quota" stands down for GEMINI_COOLDOWN_MIN
# minutes and the next one is used; when they are all cooling, the keywords
# decide on their own and nothing breaks.
GEMINI_API_KEY=
GEMINI_COOLDOWN_MIN=60

# Leave empty and the bot asks the account which models it has and picks the
# newest flash one. Set it only to pin a specific model.
GEMINI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Channels a server boost unlocks. Discord only creates the "Server Booster" role once somebody
# actually boosts, so this cannot be set up in the UI beforehand: the bot grants ViewChannel to
# that role at startup and whenever the roles change. Channels that do not exist are skipped.
BOOSTER_CHANNELS=dev-builds,behind-the-scenes

# The early-member badge. The role is made if it is not there, handed to everybody already here
# oldest-first at startup, and to each new arrival while places remain. The role's own member count
# is the tally - nothing is stored, and at most OG_LIMIT people ever wear it.
OG_ROLE_NAME=OG
OG_LIMIT=200

# ---------------------------------------------------------------------------------------------
# The dashboard (web.js). Leave DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET or DASH_BASE_URL empty
# and it simply does not start - the bot carries on doing its Discord work either way.
#
# In the Developer Portal, under OAuth2, add exactly this as a redirect:
#     <DASH_BASE_URL>/callback
# The dashboard asks Discord for the "identify" scope and nothing else. Who you are is all Discord
# tells it; whether you may see anything is decided against the guild, here.
# ---------------------------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASH_BASE_URL=https://sentinel.example.com

# Signs the session cookie. Any long random string; `openssl rand -hex 32` is one way to get one.
# Leave it empty and one is made at startup - which only means everybody is signed out on restart.
DASH_SECRET=

# Comma-separated role names that may open the dashboard. The server owner always may.
DASH_ROLES=Lovkar

# ---------------------------------------------------------------------------------------------
# The YouTube watcher (youtube.js). A new video on the channel is posted in Discord by itself.
# Leave both YOUTUBE_ settings below empty and it simply does not watch.
#
# It reads the channel's public Atom feed - no API key, no quota. What it has already posted it
# reads back out of the Discord channel, so there is still no database anywhere.
#
# NOTE: there are two such feeds. The one keyed by channel_id is built when a video is PUBLISHED,
# so a video uploaded unlisted and made public later never appears in it. The channel's uploads
# playlist (playlist_id=UU..., the same id with UC swapped for UU) does list it. The watcher reads
# the playlist first and falls back to the channel feed - nothing to configure either way.
# ---------------------------------------------------------------------------------------------
# Either the channel id (youtube.com/channel/UC...) or a handle - the handle is resolved once at
# startup. YOUTUBE_CHANNEL_ID wins if both are set. Both may be left empty: youtube.js carries
# Lovkar's own channel as its default, because CasaOS owns this app's environment block on the
# server and rewrites it on every deploy. Setting it here still wins.
YOUTUBE_CHANNEL_ID=UCuM9jBc53Gt1EQtDnUAsCeg
YOUTUBE_CHANNEL=@Lovkar_Squid

# Where the announcement goes. #announcements is an Announcement channel, so the bot also publishes
# the post to the servers that follow it (set YOUTUBE_CROSSPOST=0 to leave it unpublished).
YOUTUBE_ANNOUNCE_CHANNEL=announcements
YOUTUBE_CROSSPOST=1

# How often the feed is read, and how old a video may be and still be worth announcing. The age
# cutoff is what stops a redeploy from posting the back catalogue.
YOUTUBE_POLL_MINUTES=5
YOUTUBE_MAX_AGE_HOURS=24

# Who gets pinged. Empty = nobody, which is the polite default. "@everyone" or "<@&ROLE_ID>".
YOUTUBE_MENTION=

# {title} {url} {author} {mention} are filled in; \n is a line break.
YOUTUBE_TEMPLATE={mention}**New on YouTube: {title}**\n{url}

# ---- the book ------------------------------------------------------------------------------
# Where the bot keeps the little that Discord cannot be asked about: its log, its counters, what
# it has posted. The compose mounts ./data over /data; leave this alone unless you move it.
# If there is nowhere writable the bot says so once and runs without it, remembering nothing.
DB_PATH=/data/sentinel.db
# How many log lines are kept. A few weeks of a quiet server.
DB_LOG_KEEP=5000

# ---- giveaways -----------------------------------------------------------------------------
# Where a giveaway goes when none is named. The channel must already exist.
GIVEAWAY_CHANNEL=giveaways
# How often anything that has run out of time is looked for.
GIVEAWAY_SWEEP_SECONDS=15

# ---- polls -----------------------------------------------------------------------------------
# Discord counts the votes itself; the bot only asks the question and writes down what was said.
# Two kinds, so supporters and the wider server are not always asked the same thing.
POLL_SUPPORTER_CHANNEL=polls
POLL_PUBLIC_CHANNEL=community-polls
POLL_SWEEP_SECONDS=60

# ---- the sneak-peek queue --------------------------------------------------------------------
# Pictures dropped on the dashboard now, posted one at a time over the coming weeks. They wait on
# the same volume as the book, so a redeploy cannot lose them.
QUEUE_ENABLED=1
QUEUE_DIR=/data/queue
QUEUE_EVERY_HOURS=72
QUEUE_FROM_HOUR=9
QUEUE_TO_HOUR=22
QUEUE_SWEEP_MINUTES=15

# ---- releases --------------------------------------------------------------------------------
# A new file on Modrinth or CurseForge, announced the way a new video is. Both lists are
# comma-separated; leave one empty and that source is not polled.
#   RELEASE_MODRINTH=the-waking-world            (slug, or slug:projectId)
#   RELEASE_CURSEFORGE=the-waking-world:123456   (slug:modId - the numeric id from the URL)
RELEASE_CHANNEL=announcements
RELEASE_MODRINTH=
RELEASE_CURSEFORGE=
RELEASE_POLL_MINUTES=15
RELEASE_MAX_AGE_HOURS=48
RELEASE_TYPES=release,beta
RELEASE_MENTION=

# ---- the suggestion board --------------------------------------------------------------------
# Every idea gets its two reactions the moment it is posted, and once a week the best five are
# collected into one message. An empty week posts nothing.
SUGGESTION_CHANNEL=ideas-and-feedback
SUGGESTION_MIN_CHARS=12
SUGGESTION_TOP=5
SUGGESTION_DIGEST_DAYS=7
SUGGESTION_DIGEST=1

# ---- milestones ------------------------------------------------------------------------------
# The round numbers, once each, ever. Anything already passed when this is first switched on is
# written down silently rather than announced.
MILESTONE_CHANNEL=general
MILESTONE_MEMBERS=25,50,100,250,500,1000,2500,5000
MILESTONE_BOOSTS=1,2,5,10,15,25
MILESTONE_CHECK_MINUTES=10
MILESTONE_ENABLED=1

# ---- the "ping me about" menu ----------------------------------------------------------------
# Buttons that hand out notification roles, so @everyone is never needed. key:Role name:emoji
ROLE_MENU_CHANNEL=welcome
ROLE_MENU=releases:New releases:📦,sneaks:Sneak peeks:🔍,streams:Streams:🎥,giveaways:Giveaways:🎉
ROLE_MENU_TITLE=Ping me about…
# The menu is put up (or brought up to date) at every start. Set to 0 to leave it to /roles.
ROLE_MENU_AUTO=1

# ---- the welcome card ------------------------------------------------------------------------
# A picture with the member's name across it. Put the background on the volume so it can be
# changed without rebuilding: /data/welcome-bg.jpg
WELCOME_ENABLED=1
WELCOME_CHANNEL=welcome
WELCOME_BACKGROUND=/data/welcome-bg.jpg
WELCOME_FONT=
